<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Breath_of_the_Wild_Multiplayer.MVVM.View.LoadingView">

    <Grid ColumnDefinitions="0.4*,0.6*">
        <ContentControl Classes="loading" HorizontalAlignment="Right" VerticalAlignment="Center"/>

        <Label Content="{Binding Message}"
               Grid.Column="1"
               VerticalAlignment="Center"
               Foreground="White"
               FontFamily="Roboto"
               FontWeight="Bold"
               FontSize="36"/>
    </Grid>
</UserControl>
