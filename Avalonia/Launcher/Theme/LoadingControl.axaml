<!-- Loading spinner (WPF: Theme/LoadingControl.xaml, LoadingAnimationStyle): 8 dots, each lit
     0.1s into its 1.6s cycle then fading out, started 0.2s after the previous one. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="ContentControl.loading">
        <Setter Property="Template">
            <ControlTemplate>
                <Canvas Height="60" Width="60">
                    <Ellipse Classes="loadingDot" Name="Dot0" Canvas.Left="1.75" Canvas.Top="21"/>
                    <Ellipse Classes="loadingDot" Name="Dot1" Canvas.Left="6.5" Canvas.Top="7"/>
                    <Ellipse Classes="loadingDot" Name="Dot2" Canvas.Left="20.5" Canvas.Top="0.75"/>
                    <Ellipse Classes="loadingDot" Name="Dot3" Canvas.Left="34.75" Canvas.Top="6.75"/>
                    <Ellipse Classes="loadingDot" Name="Dot4" Canvas.Left="40.5" Canvas.Top="20.75"/>
                    <Ellipse Classes="loadingDot" Name="Dot5" Canvas.Left="34.75" Canvas.Top="34.5"/>
                    <Ellipse Classes="loadingDot" Name="Dot6" Canvas.Left="20.75" Canvas.Top="39.75"/>
                    <Ellipse Classes="loadingDot" Name="Dot7" Canvas.Left="7" Canvas.Top="34.25"/>
                </Canvas>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Ellipse.loadingDot">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Fill" Value="#009B9B9B"/>
    </Style>

    <Style Selector="ContentControl.loading /template/ Ellipse#Dot0">
        <Style.Animations><Animation Duration="0:0:1.6" IterationCount="INFINITE" Delay="0:0:0.0">
            <KeyFrame Cue="0%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
            <KeyFrame Cue="6.25%"><Setter Property="Fill" Value="#FF9B9B9B"/></KeyFrame>
            <KeyFrame Cue="100%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
        </Animation></Style.Animations>
    </Style>
    <Style Selector="ContentControl.loading /template/ Ellipse#Dot1">
        <Style.Animations><Animation Duration="0:0:1.6" IterationCount="INFINITE" Delay="0:0:0.2">
            <KeyFrame Cue="0%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
            <KeyFrame Cue="6.25%"><Setter Property="Fill" Value="#FF9B9B9B"/></KeyFrame>
            <KeyFrame Cue="100%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
        </Animation></Style.Animations>
    </Style>
    <Style Selector="ContentControl.loading /template/ Ellipse#Dot2">
        <Style.Animations><Animation Duration="0:0:1.6" IterationCount="INFINITE" Delay="0:0:0.4">
            <KeyFrame Cue="0%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
            <KeyFrame Cue="6.25%"><Setter Property="Fill" Value="#FF9B9B9B"/></KeyFrame>
            <KeyFrame Cue="100%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
        </Animation></Style.Animations>
    </Style>
    <Style Selector="ContentControl.loading /template/ Ellipse#Dot3">
        <Style.Animations><Animation Duration="0:0:1.6" IterationCount="INFINITE" Delay="0:0:0.6">
            <KeyFrame Cue="0%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
            <KeyFrame Cue="6.25%"><Setter Property="Fill" Value="#FF9B9B9B"/></KeyFrame>
            <KeyFrame Cue="100%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
        </Animation></Style.Animations>
    </Style>
    <Style Selector="ContentControl.loading /template/ Ellipse#Dot4">
        <Style.Animations><Animation Duration="0:0:1.6" IterationCount="INFINITE" Delay="0:0:0.8">
            <KeyFrame Cue="0%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
            <KeyFrame Cue="6.25%"><Setter Property="Fill" Value="#FF9B9B9B"/></KeyFrame>
            <KeyFrame Cue="100%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
        </Animation></Style.Animations>
    </Style>
    <Style Selector="ContentControl.loading /template/ Ellipse#Dot5">
        <Style.Animations><Animation Duration="0:0:1.6" IterationCount="INFINITE" Delay="0:0:1.0">
            <KeyFrame Cue="0%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
            <KeyFrame Cue="6.25%"><Setter Property="Fill" Value="#FF9B9B9B"/></KeyFrame>
            <KeyFrame Cue="100%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
        </Animation></Style.Animations>
    </Style>
    <Style Selector="ContentControl.loading /template/ Ellipse#Dot6">
        <Style.Animations><Animation Duration="0:0:1.6" IterationCount="INFINITE" Delay="0:0:1.2">
            <KeyFrame Cue="0%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
            <KeyFrame Cue="6.25%"><Setter Property="Fill" Value="#FF9B9B9B"/></KeyFrame>
            <KeyFrame Cue="100%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
        </Animation></Style.Animations>
    </Style>
    <Style Selector="ContentControl.loading /template/ Ellipse#Dot7">
        <Style.Animations><Animation Duration="0:0:1.6" IterationCount="INFINITE" Delay="0:0:1.4">
            <KeyFrame Cue="0%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
            <KeyFrame Cue="6.25%"><Setter Property="Fill" Value="#FF9B9B9B"/></KeyFrame>
            <KeyFrame Cue="100%"><Setter Property="Fill" Value="#009B9B9B"/></KeyFrame>
        </Animation></Style.Animations>
    </Style>

</Styles>
