<!-- In-game minigame timer (WPF: Theme/MinigameTimer.xaml, MinigameTimerStyle). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Label.minigameTimer">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#66000000" CornerRadius="20">
                    <Label Content="{TemplateBinding Content}"
                           Foreground="White"
                           FontFamily="Roboto"
                           FontWeight="Bold"
                           FontStyle="Italic"
                           FontSize="26"
                           Padding="60,0,60,0"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
