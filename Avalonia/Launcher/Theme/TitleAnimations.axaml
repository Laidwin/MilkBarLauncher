<!-- Page change animations (WPF: Theme/TitleAnimations.xaml). The WPF DataTriggers on
     movingLeft/movingRight become the classes of the same names, bound to those properties.
     Each slides out for 0.3s while fading, then slides in from the other side for 0.4s. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page title (labelAnim). -->
    <Style Selector="Label.slide">
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style Selector="Label.slide.movingRight">
        <Style.Animations>
            <Animation Duration="0:0:0.7">
                <KeyFrame Cue="0%"><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="42.8%"><Setter Property="Margin" Value="-100,5,100,0"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="42.9%"><Setter Property="Margin" Value="100,5,-100,0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Label.slide.movingLeft">
        <Style.Animations>
            <Animation Duration="0:0:0.7">
                <KeyFrame Cue="0%"><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="42.8%"><Setter Property="Margin" Value="100,5,-100,0"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="42.9%"><Setter Property="Margin" Value="-100,5,100,0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Names of the neighbouring pages under the arrows (buttonLabelAnim). -->
    <Style Selector="Label.buttonSlide">
        <Setter Property="Margin" Value="0,1,0,10"/>
    </Style>
    <Style Selector="Label.buttonSlide.movingRight">
        <Style.Animations>
            <Animation Duration="0:0:0.7">
                <KeyFrame Cue="0%"><Setter Property="Margin" Value="0,1,0,10"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="42.8%"><Setter Property="Margin" Value="-50,1,50,10"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="42.9%"><Setter Property="Margin" Value="50,1,-50,10"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Margin" Value="0,1,0,10"/><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Label.buttonSlide.movingLeft">
        <Style.Animations>
            <Animation Duration="0:0:0.7">
                <KeyFrame Cue="0%"><Setter Property="Margin" Value="0,1,0,10"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="42.8%"><Setter Property="Margin" Value="50,1,-50,10"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="42.9%"><Setter Property="Margin" Value="-50,1,50,10"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Margin" Value="0,1,0,10"/><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Page content (contentControlAnimations). -->
    <Style Selector="ContentControl.pageSlide.movingRight">
        <Style.Animations>
            <Animation Duration="0:0:0.7">
                <KeyFrame Cue="0%"><Setter Property="Margin" Value="0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="42.8%"><Setter Property="Margin" Value="-1000,0,1000,0"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="42.9%"><Setter Property="Margin" Value="1300,0,-1300,0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Margin" Value="0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ContentControl.pageSlide.movingLeft">
        <Style.Animations>
            <Animation Duration="0:0:0.7">
                <KeyFrame Cue="0%"><Setter Property="Margin" Value="0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="42.8%"><Setter Property="Margin" Value="1000,0,-1000,0"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="42.9%"><Setter Property="Margin" Value="-1300,0,1300,0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Margin" Value="0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Grey band behind the page, leaving room for the side bar of the first and last pages
         (backgroundMargin; classes bound to viewPosition == 1 / 2). -->
    <Style Selector="Rectangle.pageBackground.firstPage">
        <Setter Property="Margin" Value="70,0,0,0"/>
    </Style>
    <Style Selector="Rectangle.pageBackground.lastPage">
        <Setter Property="Margin" Value="0,0,70,0"/>
    </Style>

</Styles>
